# /etc/check-ip-email.env
# Copy this file to /etc/check-ip-email.env and set correct permissions:
#   sudo cp check-ip-email.env.example /etc/check-ip-email.env
#   sudo chmod 600 /etc/check-ip-email.env
#   sudo chown root:root /etc/check-ip-email.env
#
# No email is sent if the current IP matches FIXED_IP (your home network IP).
# Leave FIXED_IP empty to always send an email on boot.

# --- Network -----------------------------------------------------------

# Your usual home IP address (no email sent when matched)
FIXED_IP=10.0.1.2

# Network interface to check.
# Raspberry Pi OS:  typically eth0
# Armbian:          run `ip link` to find yours (eth0, end0, enp2s0, ...)
NETWORK_IFACE=eth0

# --- Email (Gmail) -----------------------------------------------------
# SMTP_PASSWORD must be a Gmail App Password (16 chars, no spaces).
# Create one at: myaccount.google.com/apppasswords
# Requires 2-step verification enabled on the Google account.

SMTP_USERNAME=your_sender@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_RECIPIENT=your_recipient@example.com

# --- SMTP server (defaults work for Gmail) -----------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
