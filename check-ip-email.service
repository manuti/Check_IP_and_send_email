[Unit]
Description=Check IP and send email if on foreign network
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/check_ip_no_auth.py
EnvironmentFile=/etc/check-ip-email.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
